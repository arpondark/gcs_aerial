{
  "name": "uiu-aerial-robotics-gcp",
  "version": "0.1.0",
  "description": "UIU Aerial Robotics GCP - Custom Electron Ground Control Station for ArduPilot over long-range radio modem (USB/serial).",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
