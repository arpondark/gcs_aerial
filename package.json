{
  "name": "uiu-aerial-robotics-gcp",
  "version": "0.1.0",
  "description": "UIU Aerial Robotics GCP - Custom Electron Ground Control Station for ArduPilot over long-range radio modem (USB/serial).",
  "main": "src/main/main.js",
  "private": true,

  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "mock": "electron . --mock",
    "postinstall": "electron-rebuild -f -w serialport",
    "build": "electron-builder --win",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "release": "electron-builder --publish always"
  },

  "author": "MD. Shazan Mahmud Arpon",
  "license": "MIT",

  "dependencies": {
    "electron-store": "^8.2.0",
    "serialport": "^12.0.0"
  },

  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3"
  },

  "build": {
    "appId": "com.uiuaerialrobotics.gcp",
    "productName": "UIU Aerial Robotics GCP",

    "directories": {
      "output": "dist"
    },

    "files": [
      "src/**/*",
      "package.json"
    ],

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UIU Aerial Robotics GCP"
    },

    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },

    "linux": {
      "target": [
        "AppImage",
        "deb",
        "zip"
      ]
    },

    "publish": [
      {
        "provider": "github",
        "owner": "arpondark",
        "repo": "gcs_aerial"
      }
    ]
  }
}