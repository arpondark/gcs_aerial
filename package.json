  "license": "MIT",
  "dependencies": {
    "serialport": "^12.0.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "@electron/rebuild": "^3.7.0"
  }
}
